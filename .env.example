# =============================================================================
# Sparse Index Tracker — environment variable template
# Copy to `.env` (gitignored) and fill in. Most are optional locally.
# =============================================================================

# --- MOSEK academic licence (for Phase 2 MIQP baseline & CVXPY benchmark) ---
MOSEKLM_LICENSE_FILE=/Users/pratyushgupta/mosek/mosek.lic

# --- Phase 5 API config (all SIT_-prefixed vars feed into sit.api.settings) ---
SIT_ENV=dev
SIT_APP_VERSION=1.0.0
SIT_GIT_SHA=local
SIT_DATA_DIR=data
SIT_BENCHMARKS_DIR=benchmarks/_results

# CORS allowlist for the Phase 7 Next.js frontend.
# In production, add your Vercel URL, e.g.
# ["https://sparse-index-tracker.vercel.app","http://localhost:3000"]
SIT_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Redis L2 cache; leave empty to disable.
# Local Docker uses: redis://redis:6379/0
# Azure Cache for Redis uses: rediss://:<PASSWORD>@<name>.redis.cache.windows.net:6380/0
SIT_REDIS_URL=
SIT_REDIS_TTL_S=300

# Rate limits (slowapi syntax). Decision #4: fully open API, generous limits.
SIT_RATE_LIMITS_ENABLED=true
SIT_RATE_LIMIT_DEFAULT=120/minute
SIT_RATE_LIMIT_INVEST=120/minute
SIT_RATE_LIMIT_INVEST_LIVE=30/minute

# Live retrain guardrails. Russell 2000 is too large for a public-yfinance
# request path, so very large universes are capped for the demo/API.
SIT_LIVE_UNIVERSE_MAX_TICKERS=120
SIT_LIVE_UNIVERSE_CAP_THRESHOLD=750

# Auth scaffold — currently no-op. Flip require_api_key=true in Phase 6.
SIT_API_KEYS=[]
SIT_REQUIRE_API_KEY=false

# Observability (Phase 6)
SIT_APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Azure (Phase 6) ---
AZURE_LOCATION=centralindia
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_RESOURCE_GROUP=sparse-tracker-rg
AZURE_CONTAINER_REGISTRY=sparsetrackeracr
AZURE_CONTAINER_APPS_ENVIRONMENT=sit-env
AZURE_CONTAINER_APP=sit-api
AZURE_LOG_ANALYTICS_WORKSPACE=sit-logs
AZURE_APPLICATION_INSIGHTS=sit-appinsights
AZURE_REDIS_NAME=sit-redis-cache
AZURE_APPINSIGHTS_CONNECTION_STRING=
