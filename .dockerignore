# =============================================================================
# Docker build context exclusions
# =============================================================================
.venv/
.git/
.gitignore
.github/
.vscode/
.idea/
.DS_Store

# Build / test artefacts
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
