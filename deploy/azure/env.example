# Copy this file to deploy/azure/.env and edit values if needed.
# Do not commit deploy/azure/.env if you add secrets manually.

export LOCATION=centralindia
export RESOURCE_GROUP=sparse-tracker-rg
export ACR_NAME=sparsetrackeracr
export ACA_ENV=sit-env
export CONTAINER_APP=sit-api
export LOG_WORKSPACE=sit-logs
export APP_INSIGHTS=sit-appinsights
export REDIS_NAME=sit-redis-cache

# Image repository name inside Azure Container Registry.
export IMAGE_NAME=sit-api

# Optional after Vercel deploy. Comma-free JSON string expected by pydantic-settings.
export SIT_ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
